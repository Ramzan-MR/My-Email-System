# =============================================================================
# My-Email-System environment variables
# Copy this file to .env.local (local dev) and set real values in your
# hosting provider's dashboard for production. NEVER commit real secrets.
# =============================================================================

# --- Database -----------------------------------------------------------
# PostgreSQL connection string. Any managed Postgres works (Neon, Supabase,
# Vercel Postgres, Railway). Prefer a provider with a free tier.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- App / Auth -----------------------------------------------------------
# Base URL this app is deployed at (no trailing slash).
APP_URL="http://localhost:3000"
# Used by NextAuth to sign session cookies/JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Single-owner/admin login credentials for the MVP (bcrypt hash recommended).
# Generate a hash with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD_HASH="$2a$12$replace-with-a-bcrypt-hash"

# --- Google OAuth (Gmail sending accounts + app login) --------------------
# Create OAuth 2.0 credentials in Google Cloud Console with the Gmail API
# enabled and these scopes: gmail.send, gmail.readonly, gmail.modify, userinfo.email
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the redirect URI registered in Google Cloud Console, e.g.
# {APP_URL}/api/sending-accounts/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/sending-accounts/google/callback"

# --- Token encryption -------------------------------------------------------
# 32-byte base64 key used to encrypt OAuth tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-a-random-32-byte-base64-string"

# --- AI Provider ------------------------------------------------------------
# Which provider lib/ai/index.ts should use: "gemini" (default, free tier)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
# Optional, only needed if you switch AI_PROVIDER to these:
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Google Sheets integration (optional) -----------------------------------
# Reuses the GOOGLE_CLIENT_ID/SECRET above with an added sheets scope.
GOOGLE_SHEETS_ENABLED="false"

# --- Background jobs / cron --------------------------------------------------
# Shared secret required in the Authorization header of Vercel Cron requests
# (Authorization: Bearer $CRON_SECRET) so job endpoints can't be triggered by
# outsiders. Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-secret"
